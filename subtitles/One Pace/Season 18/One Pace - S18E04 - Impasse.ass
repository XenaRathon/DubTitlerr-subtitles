Dialogue: 1,0:01:41.28,0:01:43.47,Karaoke-OP5,,0,0,0,fx,{\an5\move(691,50,628,-34)\fad(0,500)\bord0\3c&HFFFFFF&\1c&HFFFFFF&\t(200,400,\1c&HFFFFFF&)\t(400,600,\1c&HFFFFFF&)\t(600,800,\1c&HFFFFFF&)\t(800,1000,\1c&HFFFFFF&)\t(1000,1200,\1c&HFFFFFF&)\t(1200,1400,\1c&HFFFFFF&)\t(1400,1600,\1c&HFFFFFF&)\p3}m -12 4 l -12 -18 l -10 4 l -1 -5 l -9 5 l 9 5 l -9 7 l -2 14 l -10 8 l -10 27 l -12 8 l -21 16 l -13 6 l -35 5 l -13 5 l -20 -4
